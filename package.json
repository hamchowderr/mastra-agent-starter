{
  "name": "mastra-agent-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Build and deploy a Mastra AI agent. Designed to be driven by a coding agent.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "chat": "node scripts/chat.mjs",
    "eval": "node --env-file=.env --import tsx/esm scripts/eval.ts",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@mastra/auth": "^1.1.5",
    "@mastra/core": "^1.80.0",
    "@mastra/deployer-vercel": "^1.2.39",
    "@mastra/editor": "^0.16.5",
    "@mastra/evals": "^1.10.9",
    "@mastra/libsql": "^1.27.1",
    "@mastra/loggers": "^1.3.10",
    "@mastra/mcp": "~2.4.1",
    "@mastra/memory": "^1.39.1",
    "@mastra/observability": "^1.22.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "mastra": "^1.36.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vercel": "^48.0.0"
  }
}
