# Copy this file to .env — "npm run setup" does it for you.
# Every variable below says where to get its value.

# ──────────────────────────────────────────────────────────────
# LLM provider — AT LEAST ONE IS REQUIRED
# ──────────────────────────────────────────────────────────────
# Anthropic (recommended — the example agent uses claude-sonnet-4-6)
#   Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — also used for semantic-recall embeddings by default (see EMBEDDING_MODEL)
#   Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google
#   Get a key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# ──────────────────────────────────────────────────────────────
# Storage — libSQL / Turso
# ──────────────────────────────────────────────────────────────
# LOCAL: leave both blank. Uses file:./mastra.db, created on first run. No setup.
#
# DEPLOYED: both are REQUIRED. Vercel's filesystem is ephemeral, so a file:
# database silently loses all data between invocations. The app refuses to boot
# in a deployed environment without these — that is deliberate.
#   Create a database: https://turso.tech
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# ──────────────────────────────────────────────────────────────
# Embeddings (semantic recall)
# ──────────────────────────────────────────────────────────────
# Defaults to openai/text-embedding-3-small, which needs OPENAI_API_KEY above.
# A hosted model is the default because this template deploys to Vercel, where
# the local fastembed model cannot run.
# To stay on one provider, set this to that provider's embedding model, e.g.
#   EMBEDDING_MODEL=google/text-embedding-004
# EMBEDDING_MODEL=

# ──────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ──────────────────────────────────────────────────────────────
# Optional — API auth
# ──────────────────────────────────────────────────────────────
# When set, every /api/* route AND Mastra Studio require a Bearer JWT signed
# with this secret. /health stays public so deploy healthchecks work.
# Leave blank for open local development.
#   Generate one: openssl rand -hex 32
# MASTRA_JWT_SECRET=

# Disable Mastra's anonymous telemetry
MASTRA_TELEMETRY_DISABLED=1
